# MediTrack Environment Variables
# Copy to server/.env: cp .env.example server/.env

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=meditrack
DB_PASSWORD=meditrack_dev_password
DB_NAME=meditrack

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate: openssl rand -base64 32)
JWT_SECRET=generate_random_32_char_secret_with_openssl_rand_base64_32
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional - leave empty to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# SMTP (optional - leave empty to skip email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Web Push (optional - generate with web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@meditrack.com

# Node
NODE_ENV=development
PORT=3000
